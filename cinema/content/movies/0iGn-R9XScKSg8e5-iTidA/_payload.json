[{"data":1,"prerenderedAt":139},["ShallowReactive",2],{"showcase-data":3,"content-content\u002Fmovies-0iGn-R9XScKSg8e5-iTidA":4},true,{"oid":5,"url":6,"original_title":7,"description":8,"studios":9,"countries":11,"participants":13,"tags":51,"air_year":54,"kind":55,"project":56,"title":7,"rewards":60,"trailers":61,"duration":82,"age":83,"fragments":84,"assets":120,"versions":132,"show_counter":27},"movie:0iGn-R9XScKSg8e5-iTidA","\u002Fcontent\u002Fmovies\u002F0iGn-R9XScKSg8e5-iTidA\u002F","Музей Мирового океана","В России более 1000 музеев. Каждый из них по-своему уникален. Музеи искусства, техники, науки, спорта, истории. Сколько секретов и тайн они хранят, сколько невероятных историй скрывается за каждым предметом. Однако огромное внимание привлекает Музей Мирового океана в Калининграде, ведь именно океан изучен даже меньше, чем просторы космоса. Фонд хранит более 80 000 предметов. Здесь собраны коллекции фотографий, документов, раковины моллюсков, письменные источники, относящиеся к самым разным временам и событиям.\r\nКак много вы знаете про мировой океан? Считается, что про поверхность Марса изучена подробнее, чем морские глубины, однако, сведения медленно, но верно накапливаются вместе со все новыми исследованиями Земли. Познакомиться с ними можно в фильме Российского общества «Знание» о музее Мирового океана. Экспозиция собрала под одной крышей коллекции раковин моллюсков и живых рыб, геологические образцы, морские карты и даже научно-исследовательское судно-музей «Витязь», с которого впервые измерили глубину Марианской впадины. Готовы окунуться в подводный мир с головой? Тогда смело начинайте просмотр!",[10],"studio:1",[12],"country:1",[14,28,40],{"oid":15,"person":16,"job":26,"character":27},"participant:19",{"oid":17,"url":18,"first_name":19,"last_name":20,"assets":21},"person:5","\u002Fperson\u002F5\u002F","Кирилл","Степанчук",[22],{"oid":23,"asset_type":24,"resize_url":25},"asset:22","Photo","https:\u002F\u002Fi.test.ksfr.tech\u002Fmedia\u002Fcms\u002F{w}