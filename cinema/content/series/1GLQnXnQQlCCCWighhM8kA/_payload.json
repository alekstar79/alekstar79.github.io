[{"data":1,"prerenderedAt":263},["ShallowReactive",2],{"showcase-data":3,"content-content\u002Fseries-1GLQnXnQQlCCCWighhM8kA":4},true,{"oid":5,"url":6,"original_title":7,"description":8,"studios":9,"countries":11,"participants":13,"tags":220,"air_year":221,"kind":27,"project":222,"title":7,"rewards":226,"trailers":227,"end_year":27,"seasons":248},"series:1GLQnXnQQlCCCWighhM8kA","\u002Fcontent\u002Fseries\u002F1GLQnXnQQlCCCWighhM8kA\u002F","Из России с любовью","Каждый уголок нашей большой и многонациональной страны уникален своими традициями. Древние ремесла, песни и танцы, верования и обряды – все это неотъемлемая часть нашей культуры.\r\n\r\nВместе с Российским обществом «Знание» у вас есть возможность побывать на долгих свадебных церемониях кавказских народов и на казацких застольях, услышать древние напевы и увидеть, как мастера создают вышивку и оружие по технологиям своих предков. О вековых традициях и о тех, кто их хранит, в серии документальных фильмов «Из России с любовью».",[10],"studio:1",[12],"country:1",[14,28,36,48,60,64,73,84,89,100,110,121,132,143,154,164,172,183,188,198,209],{"oid":15,"person":16,"job":26,"character":27},"participant:52",{"oid":17,"url":18,"first_name":19,"last_name":20,"assets":21},"person:17","\u002Fperson\u002F17\u002F","Ксения","Носикова",[22],{"oid":23,"asset_type":24,"resize_url":25},"asset:76","Photo","https:\u002F\u002Fi.test.ksfr.tech\u002Fmedia\u002Fcms\u002F{w}x{h}\u002Fmetadata\u002Fperson\u002F17\u002F28cda409f1584ae8bfd9d50c9751d2a7.png","job:1",null,{"oid":29,"person":30,"job":26,"character":27},"participant:53",{"oid":31,"url":32,"first_name":33,"last_name":34,"assets":35},"person:18","\u002Fperson\u002F18\u002F","Наталья","Бандурина",[],{"oid":37,"person":38,"job":47,"character":27},"participant:54",{"oid":39,"url":40,"first_name":41,"last_name":42,"assets":43},"person:19","\u002Fperson\u002F19\u002F","Елена","Нупрейчик",[44],{"oid":45,"asset_type":24,"resize_url":46},"asset:78","https:\u002F\u002Fi.test.ksfr.tech\u